# Environment Configuration for Telco Customer Churn Platform
APP_ENV=development
LOG_LEVEL=INFO

# Paths
RAW_DATA_PATH=data/raw/WA_Fn-UseC_-Telco-Customer-Churn.csv
PROCESSED_DATA_PATH=data/processed/telco_churn_processed.parquet
MODEL_REGISTRY_DIR=models

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE="Telco Churn & Retention Optimization API"
API_VERSION="1.0.0"

# Dashboard Configuration
DASHBOARD_PORT=8501
API_URL=http://localhost:8000

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_EXPERIMENT_NAME=telco-customer-churn

# Business & Retention Cost Assumptions
# False Positive cost: estimated cost of retention intervention / campaign offer ($)
RETENTION_OFFER_COST=35.0
# False Negative cost multiplier: fraction of CLV lost when customer churns without intervention
CHURN_LOSS_FACTOR=1.0
# Currency conversion rate (USD to INR) for business executive reporting
USD_TO_INR_RATE=83.5
# Default Risk Classification Thresholds (Churn Probability)
CRITICAL_RISK_THRESHOLD=0.70
HIGH_RISK_THRESHOLD=0.50
MEDIUM_RISK_THRESHOLD=0.30
